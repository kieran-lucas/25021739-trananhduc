    "#W11A1\n",
    "def reverse(file):\n",
    "    with open(str(file), \"r\") as f:\n",
    "        n = int(f.read())\n",
    "    with open(str(file), \"w\") as f:\n",
    "        a = int(str(n)[::-1])\n",
    "        f.write(a)\n",
    "\n",
    "reverse(a.txt)\n",
